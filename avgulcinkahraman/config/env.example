# Copy this file to a Git-ignored local environment file before use.
# Never place production passwords, SMTP credentials, API keys, tokens, or salts here.

# Local WordPress Studio + SQLite
WP_ENVIRONMENT_TYPE=local
WP_HOME=http://localhost:8881
WP_SITEURL=http://localhost:8881
WP_LOCALE=tr_TR
WP_TIMEZONE=Europe/Istanbul
WP_PERMALINK_STRUCTURE=/%postname%/
WP_SEARCH_ENGINE_VISIBILITY=0
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

DB_ENGINE=sqlite
SQLITE_DATABASE_PATH=runtime/wordpress/wp-content/database/.ht.sqlite

# Local outbound mail must be captured, never delivered to real recipients.
WP_MAIL_MODE=intercept
WP_MAIL_TEST_RECIPIENT=mail-catcher@invalid.example

# Staging is configured separately in Hostinger and uses MariaDB.
# Keep every real value in Hostinger secrets/environment settings, not in Git.
STAGING_URL=https://staging.example.invalid
STAGING_DB_ENGINE=mariadb
STAGING_DB_HOST=REPLACE_IN_HOSTINGER
STAGING_DB_NAME=REPLACE_IN_HOSTINGER
STAGING_DB_USER=REPLACE_IN_HOSTINGER
STAGING_DB_PASSWORD=REPLACE_IN_HOSTINGER
STAGING_SEARCH_ENGINE_VISIBILITY=0
STAGING_HTTP_AUTH_ENABLED=true
